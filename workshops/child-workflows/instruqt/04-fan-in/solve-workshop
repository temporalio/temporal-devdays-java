#!/bin/bash
# ABOUTME: Skip for Challenge 4. Splices only "TODO 1" from solution/ into the
# learner's exercise (the original is saved as .bak), then runs
# `run-starter pack` so the Check sees five Completed children. Starts a Worker
# first if none is running; a running run-worker restarts on the change by itself.
source /root/.bashrc 2>/dev/null || true
set -euxo pipefail
W=/root/workshop/child-workflows
workshop-solve "$W/exercise" "$W/solution" \
    src/main/java/io/temporal/devdays/childworkflows/PackWorkflowImpl.java "TODO 1"
cd "$W/exercise"

completed() {
    temporal workflow count --address 127.0.0.1:7233 \
        --query 'WorkflowType="PackItemWorkflow" AND ExecutionStatus="Completed"' 2>/dev/null \
        | grep -oE '[0-9]+' | head -1
}

STARTED=0
if ! pgrep -f "exec:java@worker" >/dev/null; then
    nohup mvn -B -q -o compile exec:java@worker > /tmp/solve-child-worker.log 2>&1 &
    STARTED=1
    for i in $(seq 1 120); do
        grep -q "polling" /tmp/solve-child-worker.log 2>/dev/null && break
        sleep 1
    done
else
    # Give run-worker time to recompile and restart on the new code.
    sleep 15
fi

# A Worker still on the old code terminates the children; run again once it restarts.
for attempt in 1 2 3; do
    timeout 180 run-starter pack
    DONE="$(completed)"
    [ "${DONE:-0}" -ge 5 ] && break
    sleep 10
done

if [ "$STARTED" -eq 1 ]; then
    pkill -f "exec:java@worker" || true
    # Wait for it to exit, so the next Skip does not mistake it for a live Worker.
    for i in $(seq 1 60); do pgrep -f "exec:java@worker" >/dev/null || break; sleep 0.5; done
fi
