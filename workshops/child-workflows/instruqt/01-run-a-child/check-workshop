#!/bin/bash
# ABOUTME: Observe-only Check for Challenge 1 (ADR 0002). Passes once a
# ShipmentWorkflow child has Completed in the local dev server, which means
# the learner ran the Worker and `run-starter child`.
set -uo pipefail
fail() {
    if command -v fail-message >/dev/null 2>&1; then fail-message "$1"; else echo "FAIL: $1" >&2; fi
    exit 1
}

N=$(temporal workflow count --address 127.0.0.1:7233 \
    --query 'WorkflowType="ShipmentWorkflow" AND ExecutionStatus="Completed"' 2>/dev/null \
    | grep -oE '[0-9]+' | head -1)

if [ "${N:-0}" -lt 1 ]; then
    if ! pgrep -f "exec:java@worker" >/dev/null; then
        fail "No shipment child has completed yet, and no Worker is running. In the Worker tab, run 'run-worker'. Then in the Client tab, run 'run-starter child'."
    fi
    fail "No shipment child has completed yet. In the Client tab, run: run-starter child"
fi
echo "PASS: a parent ran a child to completion"
