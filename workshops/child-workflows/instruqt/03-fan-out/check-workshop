#!/bin/bash
# ABOUTME: Observe-only Check for Challenge 3 (ADR 0002). Passes once five
# PackItemWorkflow children were Terminated in the local dev server, which
# means the learner ran the Worker and `run-starter pack`.
set -uo pipefail
fail() {
    if command -v fail-message >/dev/null 2>&1; then fail-message "$1"; else echo "FAIL: $1" >&2; fi
    exit 1
}

N=$(temporal workflow count --address 127.0.0.1:7233 \
    --query 'WorkflowType="PackItemWorkflow" AND ExecutionStatus="Terminated"' 2>/dev/null \
    | grep -oE '[0-9]+' | head -1)

if [ "${N:-0}" -lt 5 ]; then
    if ! pgrep -f "exec:java@worker" >/dev/null; then
        fail "No children have been terminated yet, and no Worker is running. In the Worker tab, run 'run-worker'. Then in the Client tab, run 'run-starter pack'."
    fi
    fail "No children have been terminated yet. In the Client tab, run: run-starter pack"
fi
echo "PASS: the parent closed and TERMINATE ended its children"
